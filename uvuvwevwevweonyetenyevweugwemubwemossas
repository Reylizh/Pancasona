    local closeButton = create("TextButton", { Name = "CloseButton", Parent = topBar, BackgroundColor3 = Color3.fromRGB(255, 0, 60), BorderSizePixel = 0, Position = UDim2.new(1, -40, 0.5, -15), Size = UDim2.new(0, 30, 0, 30), Font = Enum.Font.Code, Text = "X", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 14, AutoButtonColor = true })
    create("UICorner", { Parent = closeButton, CornerRadius = UDim.new(0, 3) })
    
    local tabButtonsFrame = create("Frame", { Name = "TabButtonsFrame", Parent = mainFrame, BackgroundColor3 = Color3.fromRGB(12, 8, 20), BackgroundTransparency = 0.2, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(0, 120, 1, -80) })
    local pagesFolder = create("Folder", { Name = "PagesFolder", Parent = mainFrame })
    
    local bottomBar = create("Frame", { Name = "BottomBar", Parent = mainFrame, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.2, BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 40) })
    local statusLabel = create("TextLabel", { Name = "StatusLabel", Parent = bottomBar, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 0), Size = UDim2.new(0, 250, 1, 0), Font = Enum.Font.Code, Text = "SYS: READY", TextColor3 = Color3.fromRGB(180, 40, 255), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
    local timeLabel = create("TextLabel", { Name = "TimeLabel", Parent = bottomBar, BackgroundTransparency = 1, Position = UDim2.new(1, -115, 0, 0), Size = UDim2.new(0, 100, 1, 0), Font = Enum.Font.Code, Text = "00:00:00", TextColor3 = Color3.fromRGB(180, 40, 255), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right })
    
    local logoButton = create("TextButton", { Name = "LogoButton", Parent = screenGui, BackgroundColor3 = Color3.fromRGB(10, 5, 15), BackgroundTransparency = 0.1, Position = UDim2.new(0, 20, 0, 20), Size = UDim2.new(0, 60, 0, 60), Font = Enum.Font.Code, Text = "🌌", TextColor3 = Color3.fromRGB(180, 40, 255), TextSize = 24, Active = true })
    create("UICorner", { Parent = logoButton, CornerRadius = UDim.new(0, 3) })
    create("UIStroke", { Parent = logoButton, Color = Color3.fromRGB(180, 40, 255), Thickness = 2, Transparency = 0.1 })
    
    local tabs = {
        {Name = "System", Icon = "🖥️"},
        {Name = "Entity", Icon = "👤"},
        {Name = "Sensor", Icon = "👁️"},
        {Name = "Bypass", Icon = "🔧"},
        {Name = "Warp", Icon = "🚀"},
        {Name = "Config", Icon = "⚙️"}
    }
    
    local currentPage = nil
    local tabButtons = {}
    
    for i, tabData in pairs(tabs) do
        local tabButton = create("TextButton", { Parent = tabButtonsFrame, BackgroundColor3 = Color3.fromRGB(22, 15, 35), Position = UDim2.new(0, 10, 0, 10 + ((i - 1) * 50)), Size = UDim2.new(1, -20, 0, 45), Font = Enum.Font.Code, Text = "  " .. tabData.Icon .. "  " .. tabData.Name, TextColor3 = Color3.fromRGB(230, 200, 255), TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
        create("UICorner", { Parent = tabButton, CornerRadius = UDim.new(0, 3) })
        
        local pageFrame = create("ScrollingFrame", { Name = tabData.Name .. "Page", Parent = pagesFolder, BackgroundColor3 = Color3.fromRGB(15, 10, 22), BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 120, 0, 40), Size = UDim2.new(1, -120, 1, -80), CanvasSize = UDim2.new(0, 0, 0, 1000), ScrollBarThickness = 3, Visible = false })
        create("UIListLayout", { Parent = pageFrame, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) })
        create("UIPadding", { Parent = pageFrame, PaddingTop = UDim.new(0, 10), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })
        
        tabButton.MouseButton1Click:Connect(function()
            if currentPage then
                currentPage.Visible = false
                tabButtons[currentPage.Name].BackgroundColor3 = Color3.fromRGB(22, 15, 35)
                tabButtons[currentPage.Name].TextColor3 = Color3.fromRGB(230, 200, 255)
            end
            pageFrame.Visible = true
            tabButton.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
            tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            currentPage = pageFrame
            statusLabel.Text = "SYS: " .. tabData.Name .. " Module Loaded"
        end)
        
        tabButtons[pageFrame.Name] = tabButton
        if i == 1 then
            pageFrame.Visible = true
            tabButton.BackgroundColor3 = Color3.fromRGB(80, 20, 120)
            tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            currentPage = pageFrame
        end
