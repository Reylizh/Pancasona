local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local localPlayer = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local states = {
    fly = false,
    speed = false,
    jump = false,
    noclip = false,
    invisible = false,
    esp = false,
    xray = false,
    fullbright = false,
    antiAfk = false,
    disable3d = false,
    blackScreen = false,
    whiteScreen = false,
    disableNotif = false
}

local config = {
    flySpeed = 60,
    jumpPower = 100,
    baseSpeed = humanoid.WalkSpeed,
    baseJump = humanoid.JumpPower,
    originalQuality = settings().Rendering.QualityLevel
}

local instances = {
    bodyGyro = nil,
    bodyVelocity = nil,
    espHighlights = {},
    blackScreenUI = nil,
    whiteScreenUI = nil,
    noclipConnection = nil,
    originalSetCore = StarterGui.SetCore
}

local function create(className, properties)
    local instance = Instance.new(className)
    for key, value in pairs(properties) do
        instance[key] = value
    end
    return instance
end

local function toggleFly()
    states.fly = not states.fly
    if states.fly then
        instances.bodyGyro = create("BodyGyro", {
            Parent = rootPart,
            P = 9e5,
            MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        })
        instances.bodyVelocity = create("BodyVelocity", {
            Parent = rootPart,
            MaxForce = Vector3.new(9e9, 9e9, 9e9)
        })
        humanoid.PlatformStand = true
    else
        humanoid.PlatformStand = false
        if instances.bodyGyro then instances.bodyGyro:Destroy() end
        if instances.bodyVelocity then instances.bodyVelocity:Destroy() end
    end
end

local function toggleSpeed()
    states.speed = not states.speed
    if states.speed then
        config.baseSpeed = humanoid.WalkSpeed
        humanoid.WalkSpeed = config.flySpeed
    else
        humanoid.WalkSpeed = config.baseSpeed
    end
end

local function toggleJump()
    states.jump = not states.jump
    if states.jump then
        config.baseJump = humanoid.JumpPower
        humanoid.JumpPower = config.jumpPower
    else
        humanoid.JumpPower = config.baseJump
    end
end

local function toggleNoclip()
    states.noclip = not states.noclip
    if states.noclip then
        instances.noclipConnection = RunService.Stepped:Connect(function()
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if instances.noclipConnection then
            instances.noclipConnection:Disconnect()
        end
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

local function applyEsp(playerTarget)
    if not playerTarget.Character then return end
    local highlight = create("Highlight", {
        Parent = playerTarget.Character,
        Adornee = playerTarget.Character,
        FillColor = Color3.fromRGB(255, 0, 0),
        OutlineColor = Color3.fromRGB(255, 255, 255),
        FillTransparency = 0.5,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    })
    instances.espHighlights[playerTarget] = highlight
end

local function toggleEsp()
    states.esp = not states.esp
    if states.esp then
        for _, playerTarget in pairs(Players:GetPlayers()) do
            if playerTarget ~= localPlayer then
                applyEsp(playerTarget)
            end
        end
        Players.PlayerAdded:Connect(function(playerTarget)
            if states.esp then
                playerTarget.CharacterAdded:Connect(function()
                    if states.esp then
                        applyEsp(playerTarget)
                    end
                end)
            end
        end)
    else
        for _, highlight in pairs(instances.espHighlights) do
            highlight:Destroy()
        end
        instances.espHighlights = {}
    end
end

local function toggleXRay()
    states.xray = not states.xray
    for _, part in pairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            if states.xray and part.Transparency < 0.5 then
                part.LocalTransparencyModifier = 0.5
            else
                part.LocalTransparencyModifier = 0
            end
        end
    end
end

local function toggleFullBright()
    states.fullbright = not states.fullbright
    if states.fullbright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = Color3.new(0, 0, 0)
        Lighting.Brightness = 1
        Lighting.GlobalShadows = true
    end
end

local function toggleInvisible()
    states.invisible = not states.invisible
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") then
            part.Transparency = states.invisible and 1 or 0
        end
    end
end

local function setupAntiAfk()
    localPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function toggle3DRender()
    states.disable3d = not states.disable3d
    if states.disable3d then
        settings().Rendering.QualityLevel = 1
        for _, part in pairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 1
            end
        end
    else
        settings().Rendering.QualityLevel = config.originalQuality
        for _, part in pairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Transparency = 0
            end
        end
    end
end

local function toggleBlackScreen()
    states.blackScreen = not states.blackScreen
    if states.blackScreen then
        if states.whiteScreen then toggleWhiteScreen() end
        instances.blackScreenUI = create("Frame", {
            Name = "BlackScreen",
            Parent = CoreGui,
            BackgroundColor3 = Color3.new(0, 0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 999
        })
    else
        if instances.blackScreenUI then
            instances.blackScreenUI:Destroy()
            instances.blackScreenUI = nil
        end
    end
end

local function toggleWhiteScreen()
    states.whiteScreen = not states.whiteScreen
    if states.whiteScreen then
        if states.blackScreen then toggleBlackScreen() end
        instances.whiteScreenUI = create("Frame", {
            Name = "WhiteScreen",
            Parent = CoreGui,
            BackgroundColor3 = Color3.new(1, 1, 1),
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 999
        })
    else
        if instances.whiteScreenUI then
            instances.whiteScreenUI:Destroy()
            instances.whiteScreenUI = nil
        end
    end
end

local function toggleNotifications()
    states.disableNotif = not states.disableNotif
    if states.disableNotif then
        StarterGui.SetCore = function(serviceName, actionName, dataPayload)
            if actionName == "SendNotification" then return nil end
            return instances.originalSetCore(serviceName, actionName, dataPayload)
        end
    else
        StarterGui.SetCore = instances.originalSetCore
    end
end

RunService.RenderStepped:Connect(function()
    if states.fly and instances.bodyVelocity and instances.bodyGyro then
        local moveDirection = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection += camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection -= Vector3.new(0, 1, 0) end
        
        if moveDirection.Magnitude > 0 then moveDirection = moveDirection.Unit end
        instances.bodyVelocity.Velocity = moveDirection * config.flySpeed
        instances.bodyGyro.CFrame = camera.CFrame
    end
    
    if states.speed and humanoid then
        humanoid.WalkSpeed = config.flySpeed
    end
end)

localPlayer.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = newCharacter:WaitForChild("Humanoid")
    rootPart = newCharacter:WaitForChild("HumanoidRootPart")
    config.baseSpeed = humanoid.WalkSpeed
    config.baseJump = humanoid.JumpPower
    
    if states.invisible then toggleInvisible() toggleInvisible() end
    if states.speed then humanoid.WalkSpeed = config.flySpeed end
    if states.jump then humanoid.JumpPower = config.jumpPower end
end)

local function buildGui()
    local screenGui = create("ScreenGui", { Name = "ModernPurpleHub", Parent = CoreGui, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ResetOnSpawn = false })
    local mainContainer = create("Frame", { Name = "MainContainer", Parent = screenGui, BackgroundColor3 = Color3.fromRGB(10, 5, 15), BackgroundTransparency = 0.1, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 400, 0, 0), Size = UDim2.new(0, 400, 1, 0), Visible = false })
    create("UICorner", { Parent = mainContainer, CornerRadius = UDim.new(0, 0) })
    
    local mainFrame = create("Frame", { Name = "MainFrame", Parent = mainContainer, BackgroundColor3 = Color3.fromRGB(15, 10, 22), BackgroundTransparency = 0.1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ClipsDescendants = true })
    
    local topBar = create("Frame", { Name = "TopBar", Parent = mainFrame, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.2, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 40), Active = true })
