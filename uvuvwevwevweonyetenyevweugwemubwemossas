    local function createToggle(parent, title, icon, callback)
        local toggleFrame = create("Frame", { Parent = parent, BackgroundColor3 = Color3.fromRGB(10, 5, 15), Size = UDim2.new(1, -10, 0, 60) })
        create("UICorner", { Parent = toggleFrame, CornerRadius = UDim.new(0, 3) })
        create("TextLabel", { Parent = toggleFrame, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 10), Size = UDim2.new(0, 250, 0, 25), Font = Enum.Font.Code, Text = "  " .. icon .. "  " .. title, TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
        local toggleStatus = create("TextLabel", { Parent = toggleFrame, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 35), Size = UDim2.new(0, 250, 0, 20), Font = Enum.Font.Code, Text = "State: OFFLINE", TextColor3 = Color3.fromRGB(255, 100, 100), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left })
        local toggleBtn = create("TextButton", { Parent = toggleFrame, BackgroundColor3 = Color3.fromRGB(30, 0, 0), Position = UDim2.new(1, -80, 0, 15), Size = UDim2.new(0, 60, 0, 25), Text = "" })
        create("UICorner", { Parent = toggleBtn, CornerRadius = UDim.new(0, 3) })
        local toggleInner = create("Frame", { Parent = toggleBtn, BackgroundColor3 = Color3.fromRGB(255, 50, 50), Position = UDim2.new(0, 3, 0, 3), Size = UDim2.new(0, 19, 0, 19) })
        create("UICorner", { Parent = toggleInner, CornerRadius = UDim.new(0, 3) })
        
        local isActive = false
        toggleBtn.MouseButton1Click:Connect(function()
            isActive = not isActive
            if isActive then
                toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 10, 70)
                TweenService:Create(toggleInner, TweenInfo.new(0.2), {Position = UDim2.new(1, -22, 0, 3), BackgroundColor3 = Color3.fromRGB(180, 40, 255)}):Play()
                toggleStatus.Text = "State: ONLINE"
                toggleStatus.TextColor3 = Color3.fromRGB(180, 40, 255)
            else
                toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
                TweenService:Create(toggleInner, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.fromRGB(255, 50, 50)}):Play()
                toggleStatus.Text = "State: OFFLINE"
                toggleStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
            end
            callback(isActive)
            statusLabel.Text = "SYS: " .. title .. (isActive and " [ACTIVATED]" or " [DEACTIVATED]")
        end)
    end
    
    local function createActionBtn(parent, title, icon, callback)
        local btn = create("TextButton", { Parent = parent, BackgroundColor3 = Color3.fromRGB(22, 15, 35), Size = UDim2.new(1, -10, 0, 50), Font = Enum.Font.Code, Text = "  " .. icon .. "  " .. title, TextColor3 = Color3.fromRGB(180, 40, 255), TextSize = 14 })
        create("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 3) })
        btn.MouseButton1Click:Connect(function()
            callback()
            statusLabel.Text = "SYS: Executed " .. title
        end)
    end

    local entityPage = pagesFolder:FindFirstChild("EntityPage")
    local sensorPage = pagesFolder:FindFirstChild("SensorPage")
    local bypassPage = pagesFolder:FindFirstChild("BypassPage")
    local warpPage = pagesFolder:FindFirstChild("WarpPage")

    if entityPage then
        createToggle(entityPage, "Anti-Gravity", "✈️", toggleFly)
        createToggle(entityPage, "Overclock", "⚡", toggleSpeed)
        createToggle(entityPage, "Jump Boost", "🦘", toggleJump)
        createToggle(entityPage, "Invisible", "🌀", toggleInvisible)
        createToggle(entityPage, "No Clip", "🚫", toggleNoclip)
    end

    if sensorPage then
        createToggle(sensorPage, "Sensor Players", "🎯", toggleEsp)
        createToggle(sensorPage, "X-Ray Vision", "🔍", toggleXRay)
        createToggle(sensorPage, "Full Bright", "💡", toggleFullBright)
    end

    if bypassPage then
        createToggle(bypassPage, "Anti-AFK", "⏰", setupAntiAfk)
        createToggle(bypassPage, "Disable 3D Rendering", "🖥️", toggle3DRender)
        createToggle(bypassPage, "Black Screen", "⬛", toggleBlackScreen)
        createToggle(bypassPage, "White Screen", "⬜", toggleWhiteScreen)
        createToggle(bypassPage, "Disable Notification", "🔕", toggleNotifications)
    end

    if warpPage then
        createActionBtn(warpPage, "Warp to Spawn", "🏠", function()
            local spawnLoc = Workspace:FindFirstChild("SpawnLocation") or Workspace:FindFirstChild("Spawn")
            if spawnLoc then
                rootPart.CFrame = spawnLoc.CFrame
            else
                rootPart.CFrame = CFrame.new(0, 100, 0)
            end
        end)
        createActionBtn(warpPage, "Warp to Void Sky", "☁️", function()
            rootPart.CFrame = CFrame.new(rootPart.Position.X, rootPart.Position.Y + 1000, rootPart.Position.Z)
        end)
    end

    local isGuiVisible = false
    local function toggleGui()
        isGuiVisible = not isGuiVisible
        if isGuiVisible then
            mainContainer.Visible = true
            TweenService:Create(logoButton, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = 360, Size = UDim2.new(0, 70, 0, 70)}):Play()
            task.wait(0.2)
            TweenService:Create(mainContainer, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(1, 0, 0, 0)}):Play()
            TweenService:Create(logoButton, TweenInfo.new(0.3), {Size = UDim2.new(0, 60, 0, 60), Rotation = 0}):Play()
            statusLabel.Text = "SYS: Interface Deployed"
        else
            TweenService:Create(mainContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(1, 400, 0, 0)}):Play()
            TweenService:Create(logoButton, TweenInfo.new(0.4), {Rotation = -360, Size = UDim2.new(0, 70, 0, 70)}):Play()
            task.wait(0.4)
            mainContainer.Visible = false
            TweenService:Create(logoButton, TweenInfo.new(0.3), {Size = UDim2.new(0, 60, 0, 60), Rotation = 0}):Play()
            statusLabel.Text = "SYS: Interface Hidden"
        end
    end

    logoButton.MouseButton1Click:Connect(toggleGui)
    closeButton.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)
    
    local function makeDraggable(guiObject)
        local dragStart = nil
        local startPos = nil
        guiObject.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragStart = input.Position
                startPos = guiObject.Position
                local conn
                conn = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragStart = nil
                        conn:Disconnect()
                    end
                end)
            end
        end)
        guiObject.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
                local delta = input.Position - dragStart
                guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end
    
    makeDraggable(logoButton)

    task.spawn(function()
        while task.wait(1) do
            timeLabel.Text = os.date("%H:%M:%S")
        end
    end)

    return screenGui
end

local success, result = pcall(function()
    buildGui()
    StarterGui:SetCore("SendNotification", {
        Title = "CYBER VOID SYSTEM Loaded!",
        Text = "All modules injected successfully.",
        Duration = 5,
    })
end)
