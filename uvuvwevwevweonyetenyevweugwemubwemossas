    local function createSlider(parent, title, minVal, maxVal, currentVal, configKey)
        local sliderFrame = create("Frame", { Parent = parent, BackgroundColor3 = Color3.fromRGB(22, 15, 35), Size = UDim2.new(1, -30, 0, 70) })
        create("UICorner", { Parent = sliderFrame, CornerRadius = UDim.new(0, 8) })
        
        create("TextLabel", { Parent = sliderFrame, BackgroundTransparency = 1, Position = UDim2.new(0, 15, 0, 10), Size = UDim2.new(0, 200, 0, 20), Font = Enum.Font.Code, Text = title, TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left })
        local valLabel = create("TextLabel", { Parent = sliderFrame, BackgroundTransparency = 1, Position = UDim2.new(1, -65, 0, 10), Size = UDim2.new(0, 50, 0, 20), Font = Enum.Font.Code, Text = tostring(currentVal), TextColor3 = Color3.fromRGB(180, 40, 255), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Right })
        
        local sliderBg = create("TextButton", { Parent = sliderFrame, BackgroundColor3 = Color3.fromRGB(10, 5, 15), Position = UDim2.new(0, 15, 0, 45), Size = UDim2.new(1, -30, 0, 10), Text = "", AutoButtonColor = false })
        create("UICorner", { Parent = sliderBg, CornerRadius = UDim.new(1, 0) })
        
        local initialPercent = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)
        local sliderFill = create("Frame", { Parent = sliderBg, BackgroundColor3 = Color3.fromRGB(180, 40, 255), Size = UDim2.new(initialPercent, 0, 1, 0) })
        create("UICorner", { Parent = sliderFill, CornerRadius = UDim.new(1, 0) })
        
        local dragging = false
        
        local function updateSlider(input)
            local relativeX = math.clamp(input.Position.X - sliderBg.AbsolutePosition.X, 0, sliderBg.AbsoluteSize.X)
            local percent = relativeX / sliderBg.AbsoluteSize.X
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            local newVal = math.floor(minVal + (percent * (maxVal - minVal)))
            valLabel.Text = tostring(newVal)
            config[configKey] = newVal
            
            if configKey == "walkSpeed" and states.speed then humanoid.WalkSpeed = newVal end
            if configKey == "jumpPower" and states.jump then humanoid.JumpPower = newVal end
        end
        
        sliderBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateSlider(input)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input)
            end
        end)
    end
    
